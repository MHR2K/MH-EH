<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部对话框标题 -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_update_compare_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <!-- 加载指示器（获取新版本信息时展示） -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:padding="6dp">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_update_loading_preview"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- =================== 1. 旧版本区域（上方） =================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- 装饰竖条 -->
            <View
                android:layout_width="3.5dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_compare_badge_identical" />

            <TextView
                android:id="@+id/tv_old_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 旧版跳转按钮组 -->
            <TextView
                android:id="@+id/btn_old_first"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_compare_jump_btn"
                android:text="@string/gallery_update_jump_first" />

            <TextView
                android:id="@+id/btn_old_jump"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_compare_jump_btn"
                android:text="@string/gallery_update_jump_page" />

            <TextView
                android:id="@+id/btn_old_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_compare_jump_btn"
                android:text="@string/gallery_update_jump_last" />

        </LinearLayout>

        <!-- 旧版本漫画标题 -->
        <TextView
            android:id="@+id/tv_old_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="1dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="4dp" />

        <!-- 旧版本缩略图横向列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_old_previews"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:layout_marginBottom="10dp" />

        <!-- =================== 2. 新版本区域（中间） =================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- 装饰竖条 -->
            <View
                android:layout_width="3.5dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_compare_badge_different" />

            <TextView
                android:id="@+id/tv_new_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 新版跳转按钮组 -->
            <TextView
                android:id="@+id/btn_new_first"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_compare_jump_btn"
                android:text="@string/gallery_update_jump_first" />

            <TextView
                android:id="@+id/btn_new_jump"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_compare_jump_btn"
                android:text="@string/gallery_update_jump_page" />

            <TextView
                android:id="@+id/btn_new_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_compare_jump_btn"
                android:text="@string/gallery_update_jump_last" />

        </LinearLayout>

        <!-- 新版本漫画标题 -->
        <TextView
            android:id="@+id/tv_new_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="1dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="4dp" />

        <!-- 新版本缩略图横向列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_new_previews"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- =================== 3. 控制工具栏（下方） =================== -->
        <LinearLayout
            android:id="@+id/layout_middle_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_compare_toolbar"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp">

            <!-- 对齐状态胶囊 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_align_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_compare_status_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

            </LinearLayout>

            <!-- 操作按钮第一行：已锁定同步滑动、对齐选中页 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_lock_toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_compare_pill_btn"
                    android:text="@string/gallery_update_lock_sync"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/btn_align_selected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_compare_pill_btn"
                    android:text="@string/gallery_update_align_selected"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>

            <!-- 操作按钮第二行：全本逐页比对、自动比对（在右边） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btn_full_compare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_compare_pill_btn"
                    android:text="@string/gallery_update_full_compare"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/btn_auto_align"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_compare_pill_btn"
                    android:text="@string/gallery_update_auto_align"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>

            <!-- 全本比对结果与差异跳转（比对中或比对完成后展示） -->
            <LinearLayout
                android:id="@+id/layout_full_compare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <ProgressBar
                    android:id="@+id/pb_full_compare"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <!-- 统计报告与差异跳转文字（可点击跳转下一个差异） -->
                <TextView
                    android:id="@+id/tv_compare_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:background="@drawable/bg_compare_summary_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="11.5sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_lock_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/gallery_update_lock_hint"
                android:textSize="10.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- =================== 4. 底部操作按钮 =================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/btn_compare_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:gravity="center_vertical|start"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/cancel"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_compare_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/gallery_update_apply_mapping"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_compare_pill_btn" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
